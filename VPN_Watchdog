#!/bin/sh
# Автоустановщик Watchdog-VPN

# === НАСТРОЙКИ УСТАНОВЩИКА ===
# При обновлении скрипта меняй версию только здесь:
VERSION="v8"

echo "Установка Watchdog $VERSION..."

# 1. Настраиваем Podkop для идеальной совместимости с Watchdog
if uci show podkop >/dev/null 2>&1; then
    uci set podkop.settings.shutdown_correctly='1'
    # Принудительно открываем диагностический порт 4534
    uci set podkop.main.mixed_proxy_enabled='1'
    uci set podkop.main.mixed_proxy_port='4534'
    uci commit podkop
fi

# 2. Создаем сам скрипт сторожа
cat << 'EOF' > /etc/watchdog-vpn.sh
#!/bin/sh

W_VER="VERSION_PLACEHOLDER"
FLAG_FILE="/tmp/vpn_down_by_watchdog"
STALL_FLAG="/tmp/vpn_stalled_once"
LOCK_FILE="/tmp/watchdog_running.lock"

# Защита от наложения процессов
if [ -f "$LOCK_FILE" ]; then exit 0; fi
touch "$LOCK_FILE"

if ! command -v curl >/dev/null 2>&1; then
    logger -t "Watchdog[$W_VER]" "Установка curl для точных проверок..."
    apk add curl >/dev/null 2>&1 || opkg install curl >/dev/null 2>&1
fi

kill_vpn() {
    logger -t "Watchdog[$W_VER]" "🚨 VPN заблокирован! Возвращаем обычный интернет."
    /etc/init.d/podkop stop
    uci del dhcp.@dnsmasq[0].server >/dev/null 2>&1
    uci set dhcp.@dnsmasq[0].noresolv='0'
    uci commit dhcp
    /etc/init.d/dnsmasq restart
    ip route add unreachable 198.18.0.0/15 >/dev/null 2>&1
    date +%s > "$FLAG_FILE"
    rm -f "$STALL_FLAG"
}

check_tunnel() {
    # Multi-URL: Независимые серверы для проверки связи (Google, Cloudflare, Apple)
    URLS="http://www.gstatic.com/generate_204 http://cp.cloudflare.com/generate_204 http://captive.apple.com/hotspot-detect.html"
    
    for url in $URLS; do
        HTTP_CODE=$(curl -s -m 7 -o /dev/null -w "%{http_code}" -x socks5h://127.0.0.1:4534 "$url")
        # Если хотя бы один ответил 204 или 200, туннель 100% жив
        if [ "$HTTP_CODE" = "204" ] || [ "$HTTP_CODE" = "200" ]; then
            return 0
        fi
    done
    
    # Если никто из трех гигантов не ответил, значит VPN реально заблокирован
    return 1
}

# --- ОСНОВНАЯ ЛОГИКА ---
if pidof sing-box >/dev/null; then
    if check_tunnel; then
        ip route del unreachable 198.18.0.0/15 >/dev/null 2>&1
        rm -f "$STALL_FLAG"
    else
        if ping -c 2 -W 2 8.8.8.8 >/dev/null 2>&1; then
            if [ -f "$STALL_FLAG" ]; then
                kill_vpn
            else
                logger -t "Watchdog[$W_VER]" "Туннель завис. Быстрый рестарт Podkop..."
                /etc/init.d/podkop restart
                touch "$STALL_FLAG"
                sleep 40
            fi
        fi
    fi
else
    if [ -f "$FLAG_FILE" ]; then
        LAST_KILL=$(cat "$FLAG_FILE")
        NOW=$(date +%s)
        
        # Проверяем восстановление каждую минуту (60 сек)
        if [ $((NOW - LAST_KILL)) -gt 60 ]; then
            logger -t "Watchdog[$W_VER]" "Пробуем восстановить туннель..."
            ip route del unreachable 198.18.0.0/15 >/dev/null 2>&1
            /etc/init.d/podkop start
            sleep 40 
            
            if check_tunnel; then
                logger -t "Watchdog[$W_VER]" "✅ VPN успешно восстановлен!"
                rm -f "$FLAG_FILE" "$STALL_FLAG"
            else
                logger -t "Watchdog[$W_VER]" "Сервер все еще заблокирован. Ждем дальше."
                kill_vpn
            fi
        fi
    fi
fi

rm -f "$LOCK_FILE"
EOF

# Автоматически прописываем версию в готовый скрипт
sed -i "s/VERSION_PLACEHOLDER/$VERSION/g" /etc/watchdog-vpn.sh
chmod +x /etc/watchdog-vpn.sh

# 3. Обновляем планировщик (запуск каждую минуту)
sed -i '/watchdog-vpn.sh/d' /etc/crontabs/root
echo "* * * * * /etc/watchdog-vpn.sh" >> /etc/crontabs/root

# 4. Применяем настройки
/etc/init.d/podkop restart
/etc/init.d/cron restart

if ! grep -q "/etc/watchdog-vpn.sh" /etc/sysupgrade.conf; then
    echo "/etc/watchdog-vpn.sh" >> /etc/sysupgrade.conf
fi

sync
echo "Готово! Watchdog $VERSION успешно установлен."
